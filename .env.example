APP_NAME=Hinto AI Trader
APP_ENV=development
TRADING_MODE=paper

# Public market-data configuration only in early phases.
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_MARKET_DATA_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT","ADAUSDT","DOGEUSDT","LINKUSDT"]
BINANCE_MARKET_DATA_KLINE_INTERVAL=1m
BINANCE_MARKET_DATA_STALE_AFTER_SECONDS=10
BINANCE_MARKET_DATA_RECONNECT_MIN_DELAY=1
BINANCE_MARKET_DATA_RECONNECT_MAX_DELAY=30
BINANCE_MARKET_DATA_OPEN_TIMEOUT=10
BINANCE_MARKET_DATA_CLOSE_TIMEOUT=5
BINANCE_MARKET_DATA_RECEIVE_TIMEOUT=30
# Rotate five minutes before Binance's 24-hour connection limit.
BINANCE_MARKET_DATA_ROTATE_AFTER_SECONDS=86100
BINANCE_MARKET_DATA_WEBSOCKET_BASE_URL=wss://fstream.binance.com

# Never commit real secrets. Private credentials are intentionally not used
# by the Phase 1 paper-trading scaffold.
